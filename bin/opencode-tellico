#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
client_config="$config_dir/opencode.json"
checks="$config_dir/lib/checks.sh"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tunnel_command="$script_dir/tellico-qwen-tunnel"

# Which server hosts the lead conversation. Left to itself every device would
# pick node 0, piling every user's always-on lead onto one server and costing
# it the prompt-cache affinity that makes a long session cheap. Derive it from
# the device instead: stable, so this device always leads on the same node and
# keeps its cache, but spread across users.
default_lead_node() {
  if [ -n "${TELLICO_LEAD_NODE:-}" ]; then
    case $TELLICO_LEAD_NODE in
      0|1)
        printf '%s\n' "$TELLICO_LEAD_NODE"
        return 0
        ;;
      *)
        echo "opencode-tellico: TELLICO_LEAD_NODE must be 0 or 1," \
          "got '$TELLICO_LEAD_NODE'" >&2
        exit 2
        ;;
    esac
  fi
  seed=$(printf '%s' "${USER:-unknown}@$(uname -n)" | cksum | cut -d' ' -f1)
  printf '%s\n' "$((seed % 2))"
}

node=

usage() {
  cat <<'EOF'
usage: opencode-tellico [0|1] [OPENCODE_ARGS...]

Starts OpenCode with dual-node Tellico orchestration. The optional 0 or 1
selects the lead model; both node-pinned workers remain available.

With no number, the lead node is derived from this device, so that several
users do not all lead on node 0 and compete for one server's prompt cache.
It is stable for a given device. TELLICO_LEAD_NODE overrides it.

examples:
  opencode-tellico 0
  opencode-tellico 1 /path/to/project
  opencode-tellico 0 run 'Review this repository'

environment:
  TELLICO_LEAD_NODE
                   Force the lead node to 0 or 1 instead of deriving it from
                   this device.
  TELLICO_OPENCODE_STANDALONE
                   Force OpenCode's --standalone flag on (1) or off (0).
                   Unset, the flag is used when this OpenCode supports it,
                   because OpenCode's shared background service ignores
                   OPENCODE_CONFIG.
EOF
}

case ${1:-} in
  0|1)
    node=$1
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ -z "$node" ]; then
  node=$(default_lead_node)
fi

if ! command -v opencode >/dev/null 2>&1; then
  echo 'opencode-tellico: opencode is not installed or not on PATH' >&2
  echo 'Install it from https://opencode.ai/docs/ and rerun this command.' >&2
  exit 1
fi

if [ ! -r "$client_config" ]; then
  echo "opencode-tellico: missing $client_config" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi

if [ ! -r "$checks" ]; then
  echo "opencode-tellico: missing $checks" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi
# Installed by install.sh alongside this script.
# shellcheck disable=SC1090
. "$checks"

standalone_flag=$(tellico_opencode_standalone_flag)

if ! "$tunnel_command" start >/dev/null; then
  "$tunnel_command" status >&2 || true
  exit 1
fi

model="tellico-${node}/qwen3.8-27b"
lead_agent="orchestrate-tellico-${node}"
runtime_config="{\"model\":\"${model}\",\"small_model\":\"${model}\",\"default_agent\":\"${lead_agent}\",\"agent\":{\"compaction\":{\"model\":\"${model}\"},\"summary\":{\"model\":\"${model}\"},\"title\":{\"model\":\"${model}\"}}}"

# OpenCode's interactive command takes no --model (v2.0.24 rejects the flag
# outright), so the lead model and agent reach the session through
# $runtime_config. "opencode run" does accept it, and passing it there keeps a
# non-interactive run from depending on config precedence alone.
# $standalone_flag is one word or empty, so it must stay unquoted.
# shellcheck disable=SC2086
if [ "${1:-}" = run ]; then
  shift
  exec env OPENCODE_CONFIG="$client_config" OPENCODE_CONFIG_CONTENT="$runtime_config" \
    opencode run $standalone_flag --model "$model" "$@"
fi

# shellcheck disable=SC2086
exec env OPENCODE_CONFIG="$client_config" OPENCODE_CONFIG_CONTENT="$runtime_config" \
  opencode $standalone_flag "$@"
