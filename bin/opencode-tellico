#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
client_config="$config_dir/opencode.json"
checks="$config_dir/lib/checks.sh"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tunnel_command="$script_dir/tellico-qwen-tunnel"

node=
think=${TELLICO_THINK:-}
solo=${TELLICO_SOLO:-1}
steps=${TELLICO_STEPS:-}
websearch=${TELLICO_WEBSEARCH:-tavily}
connection=${TELLICO_CONNECTION:-}
remote_control=${TELLICO_REMOTE_CONTROL:-}
magic_context=${TELLICO_MAGIC_CONTEXT:-1}
# Exact version, never @latest: OpenCode 2 may remove an unpinned package
# mid-session when a newer one appears, and the plugin's own updater is told
# not to advance it (auto_update in config/magic-context.jsonc). Verified
# 0.47.0 against the OpenCode in use when it was added; bump deliberately,
# and together with pi/settings.json: both share one database, and processes
# of different versions on it block each other's migrations.
magic_context_package='@cortexkit/opencode-magic-context@0.47.0'
magic_context_config="$config_home/cortexkit/magic-context.jsonc"

usage() {
  cat <<'EOF'
usage: opencode-tellico [0|1] [--orchestrate] [--think LEVEL] [--steps N] [--no-magic-context]
                        [--connection tunnel|gateway] [--[no-]remote-control]
                        [OPENCODE_ARGS...]

Starts OpenCode on build-tellico: one Tellico engineer that does the whole
job on one server, reading and editing and running checks itself, with no
workers and no delegation. The optional 0 or 1 selects that server.

--orchestrate opens the session on orchestrate-tellico instead: the same
engineer, which may also delegate useful independent tasks to the two
node-pinned workers. Use it when the work splits into independent units. Both
agents are always defined, so "tab" switches between them mid-session;
--orchestrate only picks which one the session starts on. --solo, the old
switch for build-tellico, is still accepted.

With no number, the lead node is derived from this device, so that several
users do not all lead on node 0 and compete for one server's prompt cache.
It is stable for a given device. TELLICO_LEAD_NODE overrides it.

How much the model thinks is a model variant, and the config defaults every
work agent to medium. There are three ways to change it:

  --think LEVEL      the whole session, every agent, including ones you
                     switch to with "tab"
  ctrl+t             cycle the current agent's level inside the session;
                     ctrl+x t lists them. A worker keeps the level the
                     session was launched with.
  /think-LEVEL ...   one request, e.g. "/think-off fix this import order"

  off      no reasoning at all, fastest
  low      brief reasoning
  medium   the default for the leads, build-tellico and both workers
  xhigh    the most the chat template allows

OpenCode's compaction is replaced by the Magic Context plugin by default: old
history is summarised in the background by a hidden worker-slot session
instead of in one blocking summary, and project memory persists across
sessions. --no-magic-context restores OpenCode's own compaction for the
session; see "Magic Context" in the README for what the plugin costs.

examples:
  opencode-tellico 0
  opencode-tellico 0 --orchestrate
  opencode-tellico 1 --think low
  opencode-tellico 1 --orchestrate --think off
  opencode-tellico 0 --no-magic-context
  opencode-tellico 1 /path/to/project
  opencode-tellico 0 run 'Review this repository'
  opencode-tellico serve --hostname 127.0.0.1 --port 4123

"serve" starts OpenCode's headless API server with the same agents, plugins
and settings and no TUI; the tellico-vscode extension drives it. Set
OPENCODE_PASSWORD to require HTTP basic auth (user "opencode").

--remote-control lets you follow this session from a phone, and send it a
prompt or stop it: open the relay's /tellico/ page and sign in with your
gateway key. This process publishes its sessions there and nothing else; see
relay/README.md. "install.sh --remote-control" turns it on for every launch
on this device, and --no-remote-control turns it off for one.

environment:
  TELLICO_THINK    Default thinking level, same values as --think, which
                   overrides it. Unset, the agents' configured level
                   (medium) applies.
  TELLICO_SOLO     Set to 0 to open on orchestrate-tellico by default, as
                   --orchestrate does. Unset, sessions open on build-tellico.
  TELLICO_STEPS    Tool steps either primary agent may take in one turn before it
                   is made to stop and report, same as --steps, which
                   overrides it. Unset, the configured 200 applies. Raise it
                   for a long unattended session, which otherwise
                   stops and waits for input at the limit.
  TELLICO_LEAD_NODE
                   Force the lead node to 0 or 1 instead of deriving it from
                   this device.
  TELLICO_BACKGROUND_SUBAGENTS
                   Set to 1 to dispatch workers in the background in an
                   interactive session: the lead keeps working and is
                   notified as each worker finishes. Off by default, so a
                   dispatch blocks the lead until every worker in the batch
                   has reported. Never on for "run", which has no later turn
                   for a result to arrive in.
  TELLICO_OPENCODE_STANDALONE
                   Force OpenCode's --standalone flag on (1) or off (0).
                   Unset, the flag is used when this OpenCode supports it,
                   because OpenCode's shared background service ignores
                   OPENCODE_CONFIG.
  TELLICO_MAGIC_CONTEXT
                   Set to 0 to start every session with --no-magic-context.
  TELLICO_CONNECTION
                   tunnel or gateway, as --connection: reach the models over
                   the other connection than the one install.sh set up, for
                   this launch only. Each connection keeps its own key file;
                   the installed one is api-key, the other api-key.tunnel or
                   api-key.gateway. tunnel fetches its key over SSH as usual;
                   a gateway key is written by "install.sh --gateway" on a
                   gateway install, or by the VS Code extension.
  TELLICO_CONNECTION_GATEWAY_URL
                   Gateway base URL for --connection gateway. Unset, the URL
                   install.sh recorded is used.
  TELLICO_REMOTE_CONTROL
                   1 or 0, as --remote-control and --no-remote-control. Unset,
                   what install.sh recorded for this device applies, which is
                   off unless it was installed with --remote-control.
  TELLICO_LOOP_GUARD
                   Set to 0 to let a reply that has started repeating itself
                   run on. Unset, plugins/loop-guard stops it and tells the
                   session -- or a worker's lead -- to act instead.
  TELLICO_RELAY_URL
                   The relay that --remote-control publishes to. Unset, it is
                   the recorded gateway's host with /tellico in place of /v1.
  TELLICO_WEBSEARCH
                   Which service answers the agents' websearch tool: tavily
                   (the default), exa, parallel, random, or off for work whose
                   queries should not leave this machine. Every query is sent
                   to that service. OpenCode 1 has no Tavily, so there it uses
                   Exa unless parallel is chosen.
  TELLICO_AGENT_TRACE
                   Optional absolute JSONL path for tool/dispatch timing.
                   Logs metadata only, never commands, prompts or outputs.
                   Background timings measure dispatch return, not completion.
  TELLICO_T3CODE   Set to 1 to make OpenCode's built-in build agent act as
                   build-tellico, for t3code, which always picks "build".
                   install.sh sets it on the Tellico instance it adds to t3code.
EOF
}

case ${1:-} in
  0|1)
    node=$1
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  # Answered before the tunnel is touched: t3code probes "<binary> --version"
  # with a ten-second timeout before it will start a server, and bringing the
  # tunnel up, or probing the gateway, can take longer than that.
  -v|--version)
    exec opencode --version
    ;;
esac

# After the node, so "opencode-tellico 1 --think low" reads naturally. A loop
# rather than a fixed order, so --orchestrate and --think can be given either way
# round; anything else is OpenCode's own argument and is passed through
# untouched.
while [ "$#" -gt 0 ]; do
  case $1 in
    --think)
      if [ "$#" -lt 2 ]; then
        echo 'opencode-tellico: --think requires a level' >&2
        exit 2
      fi
      think=$2
      shift 2
      ;;
    --solo)
      solo=1
      shift
      ;;
    --orchestrate)
      solo=0
      shift
      ;;
    --magic-context)
      magic_context=1
      shift
      ;;
    --no-magic-context)
      magic_context=0
      shift
      ;;
    --remote-control)
      remote_control=1
      shift
      ;;
    --no-remote-control)
      remote_control=0
      shift
      ;;
    --connection)
      if [ "$#" -lt 2 ]; then
        echo 'opencode-tellico: --connection requires tunnel or gateway' >&2
        exit 2
      fi
      connection=$2
      shift 2
      ;;
    --steps)
      if [ "$#" -lt 2 ]; then
        echo 'opencode-tellico: --steps requires a number' >&2
        exit 2
      fi
      steps=$2
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

case $solo in
  0|1) ;;
  false|no|off) solo=0 ;;
  true|yes|on) solo=1 ;;
  *)
    echo "opencode-tellico: TELLICO_SOLO must be 0 or 1, got '$solo'" >&2
    exit 2
    ;;
esac

case $steps in
  '') ;;
  *[!0-9]* | 0)
    echo "opencode-tellico: --steps must be a positive number, got '$steps'" >&2
    exit 2
    ;;
esac

case $magic_context in
  0|1) ;;
  false|no|off) magic_context=0 ;;
  true|yes|on) magic_context=1 ;;
  *)
    echo "opencode-tellico: TELLICO_MAGIC_CONTEXT must be 0 or 1, got '$magic_context'" >&2
    exit 2
    ;;
esac

case $websearch in
  tavily|exa|parallel|random|off) ;;
  *)
    echo "opencode-tellico: unknown TELLICO_WEBSEARCH '$websearch'" >&2
    echo 'Use one of: tavily, exa, parallel, random, off' >&2
    exit 2
    ;;
esac

case $connection in
  ''|tunnel|gateway) ;;
  *)
    echo "opencode-tellico: unknown connection '$connection'" >&2
    echo 'Use tunnel or gateway.' >&2
    exit 2
    ;;
esac

case $think in
  ''|off|low|medium|xhigh) ;;
  *)
    echo "opencode-tellico: unknown thinking level '$think'" >&2
    echo 'Use one of: off, low, medium, xhigh' >&2
    exit 2
    ;;
esac

if ! command -v opencode >/dev/null 2>&1; then
  echo 'opencode-tellico: opencode is not installed or not on PATH' >&2
  echo 'Install it from https://opencode.ai/docs/ and rerun this command.' >&2
  exit 1
fi

if [ ! -r "$client_config" ]; then
  echo "opencode-tellico: missing $client_config" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi

if [ ! -r "$checks" ]; then
  echo "opencode-tellico: missing $checks" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi

# Without its config the plugin loads but its historian has no model, so the
# session is never summarised and runs into the plugin's overflow refusal
# instead. Better to stop here than to start a session that fails late.
if [ "$magic_context" = 1 ] && [ ! -r "$magic_context_config" ]; then
  echo "opencode-tellico: Magic Context needs $magic_context_config" >&2
  echo 'Rerun install.sh --no-start from the tellico-agentic-setup repository,' >&2
  echo 'or pass --no-magic-context to use OpenCode compaction instead.' >&2
  exit 1
fi
# Installed by install.sh alongside this script.
# shellcheck disable=SC1090
. "$checks"

# Shared with pi-tellico, so one device does not lead on node 0 in one harness
# and node 1 in the other.
if [ -z "$node" ]; then
  node=$(tellico_default_lead_node) || exit $?
fi

standalone_flag=$(tellico_opencode_standalone_flag)

# --connection repoints all four providers for this launch, leaving the
# installed config alone: a per-launch provider entry is merged over the
# installed one (verified on 2.0.26), so the models, variants and worker
# header stay and only the URL and key change. The tunnel helper reads the
# same variable, so it brings up an SSH tunnel or only probes the gateway to
# match. client.env is read for the recorded ports and gateway URL.
if [ -n "$connection" ]; then
  if [ -r "$config_dir/client.env" ]; then
    # Generated by install.sh after validating each value.
    # shellcheck disable=SC1091
    . "$config_dir/client.env"
  fi
  installed_mode=${TELLICO_MODE:-tunnel}
  key_file=$(tellico_key_file "$config_dir" "$installed_mode" "$connection")
  if [ "$connection" = gateway ]; then
    gateway=${TELLICO_CONNECTION_GATEWAY_URL:-${TELLICO_GATEWAY_URL:-}}
    if [ -z "$gateway" ]; then
      echo 'opencode-tellico: no gateway URL. Set TELLICO_CONNECTION_GATEWAY_URL,' >&2
      echo 'or rerun install.sh, which records the built-in one.' >&2
      exit 1
    fi
    if [ ! -s "$key_file" ]; then
      echo "opencode-tellico: no gateway API key in $key_file" >&2
      echo 'Set one with "Tellico: Set Gateway API Key" in VS Code, or write it' >&2
      echo "there yourself with mode 600." >&2
      exit 1
    fi
    TELLICO_CONNECTION_GATEWAY_URL=$gateway
    export TELLICO_CONNECTION_GATEWAY_URL
  fi
  base0=$(tellico_base_url "$connection" "${gateway:-}" 0 "${TELLICO_QWEN_PORT0:-18080}")
  base1=$(tellico_base_url "$connection" "${gateway:-}" 1 "${TELLICO_QWEN_PORT1:-18081}")
  TELLICO_CONNECTION=$connection
  export TELLICO_CONNECTION
fi

# Remote control: plugins/remote-control publishes this process's sessions to
# the relay and takes prompts and stops back from the user's phone. Off unless
# asked for, by flag, by environment or by what install.sh recorded. It signs
# in with the user's gateway key -- in tunnel mode the one in api-key.gateway,
# never the cluster key in api-key. A device without a key or a relay URL
# still launches; it just is not visible from the phone. The variables are
# exported rather than passed on the command line, so a value with a space in
# it survives, and set to 0 explicitly so an inherited 1 cannot switch it on.
tellico_client_env() {
  sed -n "s/^$1='\(.*\)'$/\1/p" "$config_dir/client.env" 2>/dev/null | head -n 1
}
if [ -z "$remote_control" ]; then
  remote_control=$(tellico_client_env TELLICO_REMOTE_CONTROL)
fi
case $remote_control in
  1|on|true|yes) remote_control=1 ;;
  *) remote_control=0 ;;
esac
if [ "$remote_control" = 1 ]; then
  relay_mode=$(tellico_client_env TELLICO_MODE)
  relay_key=$(tellico_key_file "$config_dir" "${relay_mode:-tunnel}" gateway)
  relay_url=${TELLICO_RELAY_URL:-}
  if [ -z "$relay_url" ]; then
    relay_gateway=${TELLICO_CONNECTION_GATEWAY_URL:-$(tellico_client_env TELLICO_GATEWAY_URL)}
    relay_gateway=${relay_gateway%/}
    [ -n "$relay_gateway" ] && relay_url="${relay_gateway%/v1}/tellico"
  fi
  if [ ! -s "$relay_key" ]; then
    echo "opencode-tellico: remote control needs a gateway key in $relay_key;" >&2
    echo '  starting without it. "install.sh --gateway" or the VS Code extension sets one.' >&2
    remote_control=0
  elif [ -z "$relay_url" ]; then
    echo 'opencode-tellico: remote control has no relay URL; starting without it.' >&2
    echo '  Set TELLICO_RELAY_URL, or rerun install.sh to record the gateway.' >&2
    remote_control=0
  else
    TELLICO_RELAY_URL=$relay_url
    TELLICO_RELAY_KEY_FILE=$relay_key
    export TELLICO_RELAY_URL TELLICO_RELAY_KEY_FILE
  fi
fi
TELLICO_REMOTE_CONTROL=$remote_control
export TELLICO_REMOTE_CONTROL

if ! "$tunnel_command" start >/dev/null; then
  "$tunnel_command" status >&2 || true
  exit 1
fi

# A finished worker's slot cannot be reused while the lead is still blocked on
# the rest of its tool-call batch, so a lopsided pair idles a server until its
# slowest member ends. Background subagents remove that barrier: the lead is
# notified as each worker lands and can dispatch into the freed slot. The task
# tool only grows its "background" parameter when this is set, which is why it
# travels with the session rather than living in the config.
#
# It is off by default since 2026-10-14, and TELLICO_BACKGROUND_SUBAGENTS=1
# turns it on. In practice the model handled the asynchrony badly: a lead
# with workers in flight has to track which reports are still owed, take
# completion notifications mid-turn, and keep the shared status file in step
# with commits landing underneath it, and the leads on this cluster lost
# track -- stale status files, and a lead arguing with itself over whether to
# dispatch the next slice or record the last one until it looped. Blocking
# on the batch gives up overlap but leaves one simple order: dispatch, wait,
# read both reports, decide. It also frees the lead's slot for other users
# while the workers run, which matters on four shared slots. And upstream
# issue 48826 reports a subagent with pending background work being marked
# complete early and its result never collected.
#
# "opencode run" never gets it, whatever the variable says. A one-shot run
# ends its turn as soon as the model stops speaking, and a background result
# arrives as a notification that needs a *later* turn to land in, so there is
# nowhere for it to go. Measured, not assumed: the same two-worker dispatch
# that reports both lines in the foreground ends with "Waiting for their
# reports" and loses both when run in the background. An interactive session
# has further turns and is the only place the notification can be delivered.
case ${TELLICO_BACKGROUND_SUBAGENTS:-0} in
  1|true|yes|on)
    background_env=OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
    ;;
  *)
    background_env=OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=false
    ;;
esac

model_id=qwen3.8-27b-gsq-iq3s
model="tellico-${node}/${model_id}"
# The same server model with thinking hard-off and no variants, for the
# session's own overhead (title, summary, compaction, small_model). OpenCode 2
# applies the *session's* variant to every request in it, these agents
# included, and ignores an agent-level variant for them, so a separate model
# entry is the only thing that keeps a title or a summary from reasoning
# under --think xhigh. plugins/compaction-guard still covers OpenCode 1.
quiet_model="${model}-quiet"
# Which primary agent the session opens on: build-tellico by default, which
# does the whole job on one server and cannot dispatch at all, or with
# --orchestrate the lead that can also delegate useful independent units. Both are defined for
# both nodes, so "tab" still switches between them inside a session -- this only picks the one the
# session starts with.
if [ "$solo" = 1 ]; then
  lead_agent="build-tellico-${node}"
else
  lead_agent="orchestrate-tellico-${node}"
fi
# The lead's own generation lands on this node, so plugins/dispatch-balance.js
# records it in optional traces. Exporting the resolved value also makes it
# visible to other session helpers, and matches an explicit user selection.
export TELLICO_LEAD_NODE="$node"
# Background workers run while the lead keeps talking, so their entries
# scroll out of view. tui.json loads a sidebar panel listing them, and binds
# the model-variant list to <leader>t so the thinking level can be picked
# rather than only cycled with the built-in ctrl+t. OpenCode merges it over the
# user's own tui.json rather than replacing it. Skipped when an older install
# never wrote one, and on OpenCode 2: the vendored panel is written against
# OpenCode 1's TUI plugin API ({id, tui}) and has no OpenCode 2 release, whose
# TUI plugins are {id, setup}. Skipping it there costs only the extra binding;
# ctrl+t is built in. An unreadable version keeps the old behaviour.
opencode_major=$(tellico_opencode_major)
if [ -r "$config_dir/tui.json" ] && [ "${opencode_major:-1}" -lt 2 ]; then
  export OPENCODE_TUI_CONFIG="$config_dir/tui.json"
fi
# OpenCode 2 reads TUI plugins from the "plugins" list of its CLI config
# (~/.config/opencode/cli.json), not tui.json, and takes a per-launch overlay
# in OPENCODE_CLI_CONFIG_CONTENT. The overlay replaces arrays rather than
# merging them, so the user's own plugins are read and kept. When they cannot
# be read safely the panel is skipped instead of dropping them.
if [ "${opencode_major:-1}" -ge 2 ] && [ -z "${OPENCODE_CLI_CONFIG_CONTENT:-}" ] &&
  [ -r "$config_dir/plugins/tui-v2/subagents/tui.js" ]; then
  cli_overlay=$(tellico_cli_plugin_overlay "$config_dir/plugins/tui-v2/subagents")
  if [ -n "$cli_overlay" ]; then
    export OPENCODE_CLI_CONFIG_CONTENT="$cli_overlay"
  fi
fi
# OpenCode's own websearch tool is the agents' web search: one "query"
# argument, results capped by tool_output like any other tool. An MCP search
# server was considered and rejected, because its four tool schemas would ride
# along on every turn of every agent and its extract tool duplicates webfetch.
# OpenCode 2 takes the provider from config; left unset it asks the user on
# first use, which a background worker would wait on for a minute and then
# cancel. Tavily is pinned rather than "random" because its results are a
# quarter of the size of Exa's, so less of them is lost to the tool_output cap;
# the cost is no failover when keyless use is rate limited, which a
# TAVILY_API_KEY in the environment lifts. OpenCode 1 has only Exa and
# Parallel, enabled by an environment variable rather than config.
websearch_config=
websearch_env=
if [ "${opencode_major:-1}" -ge 2 ]; then
  case $websearch in
    off) websearch_config=',"websearch":false' ;;
    *) websearch_config=",\"websearch\":{\"provider\":\"${websearch}\"}" ;;
  esac
else
  case $websearch in
    off) ;;
    parallel) websearch_env=OPENCODE_ENABLE_PARALLEL=1 ;;
    *) websearch_env=OPENCODE_ENABLE_EXA=1 ;;
  esac
fi

# A thinking level is a model variant, so it is set per agent, and it overrides
# the medium that config/opencode.json gives every work agent. All six get it,
# not only the one this session opens on, because "tab" switches primary agent
# inside a session and --think is meant to hold for the session. Title, summary
# and compaction are excluded: they are the session's own overhead and are held
# at no thinking at all, by their agent options and by
# plugins/compaction-guard, so that a summary cannot spend its output budget on
# reasoning and come back truncated -- which ends the session.
#
# --steps applies to both primary agents. Workers keep their bounded limits
# so extending an unattended session does not extend every delegated task.
# One JSON object per agent carries both settings, because a repeated key lets the
# later one silently replace the earlier.
think_overrides=""
for tellico_agent in orchestrate-tellico-0 orchestrate-tellico-1 \
  build-tellico-0 build-tellico-1 tellico-worker-0 tellico-worker-1; do
  tellico_fields=""
  if [ -n "$think" ]; then
    tellico_fields="\"variant\":\"${think}\""
  fi
  case $tellico_agent in
    build-tellico-*|orchestrate-tellico-*)
      if [ -n "$steps" ]; then
        tellico_fields="${tellico_fields:+${tellico_fields},}\"steps\":${steps}"
      fi
      ;;
  esac
  if [ -n "$tellico_fields" ]; then
    think_overrides="${think_overrides},\"${tellico_agent}\":{${tellico_fields}}"
  fi
done

# Magic Context is added here rather than in config/opencode.json so that
# --no-magic-context can leave it out: the package comes from npm, which
# OpenCode fetches itself on first use, so that switch is also the way to
# start a session without the network. Only the package is named. A "plugin" list given this way is
# appended to the installed file's list, not merged with it, and a plugin
# named in both loads twice -- measured on 2.0.26 with marker-writing probe
# plugins, where the duplicate's server hook ran twice -- so repeating the
# three local plugins here would double every guard. OpenCode 1 and 2 both
# read "plugin". The plugin owns the window from here, so OpenCode's own
# compaction and pruning are turned off the way its setup wizard does;
# compaction.reserved and the rest of that block become inert for the session.
magic_context_config_json=
if [ "$magic_context" = 1 ]; then
  magic_context_config_json=",\"plugin\":[\"${magic_context_package}\"],\"compaction\":{\"auto\":false,\"prune\":false}"
fi

# One per-launch "provider" block, because a repeated key would let the later
# copy replace the earlier: --connection repoints the endpoints, and on
# OpenCode 2 --think sets the model-level thinking level. OpenCode 2 ignores
# an agent's variant when it opens a session -- the think_overrides above
# only reach OpenCode 1 -- but it does send model options.extraBody, merged
# under whatever variant the session later picks (ctrl+t, /think-*), so the
# narrower scope still wins (measured on 2.0.26). The quiet model is a
# separate entry and keeps thinking off.
# OpenCode 1 keeps the plain model for overhead: plugins/compaction-guard
# already forces thinking off there, and the quiet entry is only proven on 2.
if [ "${opencode_major:-1}" -lt 2 ]; then
  quiet_model=$model
fi
think_kwargs=
think_stop=
if [ -n "$think" ] && [ "${opencode_major:-1}" -ge 2 ]; then
  if [ "$think" = off ]; then
    think_kwargs='{"enable_thinking":false,"preserve_thinking":false}'
    # See the "off" variant in config/opencode.json: with thinking off the
    # model sometimes closes a reasoning block it never opened and starts
    # its answer over; stopping at that tag keeps the first, whole answer.
    think_stop=',"stop":["</think>"]'
  else
    think_kwargs="{\"enable_thinking\":true,\"reasoning_effort\":\"${think}\",\"preserve_thinking\":false}"
  fi
fi
provider_config=
if [ -n "$connection" ] || [ -n "$think_kwargs" ]; then
  for tellico_provider in tellico-0 tellico-0-worker tellico-1 tellico-1-worker; do
    tellico_fields=
    if [ -n "$connection" ]; then
      case $tellico_provider in
        tellico-0*) tellico_base=$base0 ;;
        *) tellico_base=$base1 ;;
      esac
      tellico_fields="\"options\":{\"baseURL\":\"${tellico_base}\",\"apiKey\":\"{file:${key_file}}\"}"
    fi
    if [ -n "$think_kwargs" ]; then
      tellico_fields="${tellico_fields:+${tellico_fields},}\"models\":{\"${model_id}\":{\"options\":{\"extraBody\":{\"chat_template_kwargs\":${think_kwargs}${think_stop}}}}}"
    fi
    provider_config="${provider_config}\"${tellico_provider}\":{${tellico_fields}},"
  done
  provider_config=",\"provider\":{${provider_config%,}}"
fi

# t3code has no agent picker for OpenCode 2: every turn it switches the
# session to the agent named "build", or "plan" in its plan mode, whatever
# default_agent says. So for a server t3code starts (install.sh sets
# TELLICO_T3CODE=1 on its Tellico instance) the built-in build agent is
# redefined as build-tellico on the lead node. OpenCode merges these fields
# over its own build agent. Of build-tellico's permissions only the two
# denies are copied: t3code writes its own session rules for its approval
# modes, and an agent-level "allow" for bash or edit would override them.
# Keep the rest in step with build-tellico in config/opencode.json; a test
# compares the two.
t3code_build=
case ${TELLICO_T3CODE:-0} in
  1|true|yes|on)
    t3code_build=",\"build\":{\"description\":\"build-tellico on node ${node}, as t3code's build agent.\",\"model\":\"${model}\",\"variant\":\"${think:-medium}\",\"temperature\":0.5,\"top_p\":0.95,\"prompt\":\"{file:${config_dir}/prompts/build.md}\",\"steps\":${steps:-200},\"permission\":{\"task\":\"deny\",\"doom_loop\":\"deny\"}}"
    ;;
esac

runtime_config="{\"model\":\"${model}\",\"small_model\":\"${quiet_model}\",\"default_agent\":\"${lead_agent}\",\"agent\":{\"compaction\":{\"model\":\"${quiet_model}\"},\"summary\":{\"model\":\"${quiet_model}\"},\"title\":{\"model\":\"${quiet_model}\"}${think_overrides}${t3code_build}}${websearch_config}${magic_context_config_json}${provider_config}}"

# OpenCode's interactive command takes no --model (v2.0.24 rejects the flag
# outright), so the lead model and agent reach the session through
# $runtime_config. "opencode run" does accept it, and passing it there keeps a
# non-interactive run from depending on config precedence alone.
# $standalone_flag, $background_env and $websearch_env are each one word or
# empty, so all three must stay unquoted.
# shellcheck disable=SC2086
if [ "${1:-}" = run ]; then
  shift
  # No later turn to deliver a background result into; see above.
  background_env=OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=false
  exec env $background_env $websearch_env OPENCODE_CONFIG="$client_config" \
    OPENCODE_CONFIG_CONTENT="$runtime_config" \
    opencode run $standalone_flag --model "$model" "$@"
fi

# "serve" is the headless API server the tellico-vscode extension drives: the
# same agents, plugins and runtime config as the TUI, with no TUI. A plain
# "opencode serve" is already a private server (only "--service" registers the
# shared one), so it needs no --standalone, and it reads OPENCODE_CONFIG like a
# standalone TUI does. It follows the same dispatch default as the TUI, and
# TELLICO_BACKGROUND_SUBAGENTS=1 can turn background on here too: a client UI
# stays connected and has later turns for the notification to land in, which
# is exactly what "run" lacks.
# shellcheck disable=SC2086
if [ "${1:-}" = serve ]; then
  shift
  exec env $background_env $websearch_env OPENCODE_CONFIG="$client_config" \
    OPENCODE_CONFIG_CONTENT="$runtime_config" \
    opencode serve "$@"
fi

# shellcheck disable=SC2086
exec env $background_env $websearch_env OPENCODE_CONFIG="$client_config" \
  OPENCODE_CONFIG_CONTENT="$runtime_config" \
  opencode $standalone_flag "$@"
