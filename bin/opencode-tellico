#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
client_config="$config_dir/opencode.json"
checks="$config_dir/lib/checks.sh"
env_file="$config_dir/client.env"
key_file="$config_dir/api-key"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tunnel_command="$script_dir/tellico-qwen-tunnel"
node=0

if [ -r "$env_file" ]; then
  # Generated by install.sh after validating each value. tellico-qwen-tunnel
  # owns the forwards; these are the local ends of them.
  # shellcheck disable=SC1090
  . "$env_file"
fi
port0=${TELLICO_QWEN_PORT0:-18080}
port1=${TELLICO_QWEN_PORT1:-18081}

usage() {
  cat <<'EOF'
usage: opencode-tellico [0|1] [OPENCODE_ARGS...]

Starts OpenCode with dual-node Tellico orchestration. The optional 0 or 1
selects which node hosts the lead; both node-pinned workers remain available.

Each node's model is discovered at launch by asking it, so when the cluster
serves different models on the two nodes the selector also chooses the model:
with Qwen3.8-Flash-Next on node 1, "opencode-tellico 1" leads on Flash-Next
and "opencode-tellico 0" leads on the 27B. Nothing here needs editing when the
cluster profile changes.

examples:
  opencode-tellico 0
  opencode-tellico 1 /path/to/project
  opencode-tellico 0 run 'Review this repository'

environment:
  TELLICO_OPENCODE_STANDALONE
                   Force OpenCode's --standalone flag on (1) or off (0).
                   Unset, the flag is used when this OpenCode supports it,
                   because OpenCode's shared background service ignores
                   OPENCODE_CONFIG.
EOF
}

case ${1:-} in
  0|1)
    node=$1
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

if ! command -v opencode >/dev/null 2>&1; then
  echo 'opencode-tellico: opencode is not installed or not on PATH' >&2
  echo 'Install it from https://opencode.ai/docs/ and rerun this command.' >&2
  exit 1
fi

if [ ! -r "$client_config" ]; then
  echo "opencode-tellico: missing $client_config" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi

if [ ! -r "$checks" ]; then
  echo "opencode-tellico: missing $checks" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi
# Installed by install.sh alongside this script.
# shellcheck disable=SC1090
. "$checks"

standalone_flag=$(tellico_opencode_standalone_flag)

if ! "$tunnel_command" start >/dev/null; then
  "$tunnel_command" status >&2 || true
  exit 1
fi

# Ask a node which model it has loaded. The cluster can run a different profile
# per node, so resolving the alias here is what lets a model change on the
# cluster need no edit on the client.
#
# /v1/models is one line of compact JSON holding several "id" keys, so the body
# is split on commas first: a greedy match over the whole line would return the
# last id rather than the model's.
served_model() {
  curl -fsS --max-time 10 \
    -H "Authorization: Bearer $(cat "$key_file")" \
    "http://127.0.0.1:${1}/v1/models" 2>/dev/null |
    tr ',' '\n' |
    sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
    head -n 1
}

# The tunnel's start already waited for both servers to answer /health, so an
# empty answer here means something unusual; fall back to the long-standing
# alias rather than refusing to launch.
model0=$(served_model "$port0") || model0=''
model1=$(served_model "$port1") || model1=''
: "${model0:=qwen3.8-27b}"
: "${model1:=qwen3.8-27b}"

if [ "$node" = 0 ]; then
  lead_model="tellico-0/$model0"
  aux_model="tellico-1/$model1"
else
  lead_model="tellico-1/$model1"
  aux_model="tellico-0/$model0"
fi
lead_agent="orchestrate-tellico-${node}"

# Where the two worker agents run.
#
# Both nodes on the same model: keep the historical pinning, worker 0 on node 0
# and worker 1 on node 1, so a parallel pair uses both servers and all four
# slots stay reachable.
#
# Nodes on different models: send both workers to the node the lead is not on.
# Splitting the pair across the nodes would put half the bulk reading on the
# large slow model and make that worker contend with the lead for the same
# node's slots. Keeping them together gives the intended shape instead -- the
# lead reasons on one model while a pool of workers grinds through the reading
# on the other.
if [ "$model0" = "$model1" ]; then
  worker0_model="tellico-0/$model0"
  worker1_model="tellico-1/$model1"
else
  worker0_model="$aux_model"
  worker1_model="$aux_model"
fi

# Title, summary and compaction are frequent, low-judgement calls, so they go
# to the node that is not hosting the lead. That keeps them off the lead's
# slots and, in a split layout where one node holds a large slow model, runs
# the housekeeping on the faster one.
runtime_config=$(printf '%s' \
  "{\"model\":\"${lead_model}\"," \
  "\"small_model\":\"${aux_model}\"," \
  "\"default_agent\":\"${lead_agent}\"," \
  "\"agent\":{" \
  "\"compaction\":{\"model\":\"${aux_model}\"}," \
  "\"summary\":{\"model\":\"${aux_model}\"}," \
  "\"title\":{\"model\":\"${aux_model}\"}," \
  "\"orchestrate-tellico-0\":{\"model\":\"tellico-0/${model0}\"}," \
  "\"orchestrate-tellico-1\":{\"model\":\"tellico-1/${model1}\"}," \
  "\"tellico-worker-0\":{\"model\":\"${worker0_model}\"}," \
  "\"tellico-worker-1\":{\"model\":\"${worker1_model}\"}" \
  "}}")

# Silent when both nodes serve the same model, which is how it always was.
# Worth a line when they differ, because then the node number also picks the
# model and getting the wrong one is easy to miss.
if [ "$model0" != "$model1" ]; then
  printf 'tellico: lead %s | both workers %s | housekeeping %s\n' \
    "$lead_model" "$worker0_model" "$aux_model" >&2
fi

# OpenCode's interactive command takes no --model (v2.0.24 rejects the flag
# outright), so the lead model and agent reach the session through
# $runtime_config. "opencode run" does accept it, and passing it there keeps a
# non-interactive run from depending on config precedence alone.
# $standalone_flag is one word or empty, so it must stay unquoted.
# shellcheck disable=SC2086
if [ "${1:-}" = run ]; then
  shift
  exec env OPENCODE_CONFIG="$client_config" OPENCODE_CONFIG_CONTENT="$runtime_config" \
    opencode run $standalone_flag --model "$lead_model" "$@"
fi

# shellcheck disable=SC2086
exec env OPENCODE_CONFIG="$client_config" OPENCODE_CONFIG_CONTENT="$runtime_config" \
  opencode $standalone_flag "$@"
