#!/bin/sh
# Run Codex against the Tellico Qwen servers instead of OpenAI.
#
# Codex keeps its own provider configuration, so this does not replace it: a
# plain "codex" still uses whatever ~/.codex/config.toml says, and this command
# layers a generated profile that points at one Tellico node. Switching between
# local and OpenAI is therefore a matter of which command you run.
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
env_file="$config_dir/client.env"
key_file="$config_dir/api-key"
codex_home=${CODEX_HOME:-"$HOME/.codex"}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tunnel_command="$script_dir/tellico-qwen-tunnel"

if [ -r "$env_file" ]; then
  # Generated by install.sh after validating each value.
  # shellcheck disable=SC1090
  . "$env_file"
fi

node=
think=${TELLICO_THINK:-}

usage() {
  cat <<'EOF'
usage: codex-tellico [0|1] [--think LEVEL] [CODEX_ARGS...]

Starts Codex against one Tellico node. With no number, the node is derived
from this device so that several users spread across both servers.

  codex-tellico                 # this device's node, interactive
  codex-tellico 1               # pin to node 1
  codex-tellico 0 exec 'hello'  # non-interactive
  codex                         # unchanged: your own OpenAI setup

--think sets how much the model reasons: low, medium or xhigh. Unlike
OpenCode there is no "off": Codex always asks for reasoning. Note that Codex's
own default of "high" is not a value this chat template accepts, which is why
the generated profile pins it.

environment:
  TELLICO_THINK    Default thinking level, same values as --think.
  TELLICO_CODEX_NODE
                   Force the node to 0 or 1 instead of deriving it.
EOF
}

case ${1:-} in
  0|1)
    node=$1
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ "${1:-}" = --think ]; then
  if [ "$#" -lt 2 ]; then
    echo 'codex-tellico: --think requires a level' >&2
    exit 2
  fi
  think=$2
  shift 2
fi

# "off" is deliberately absent: Codex has no way to send enable_thinking.
case $think in
  ''|low|medium|xhigh) ;;
  *)
    echo "codex-tellico: unknown thinking level '$think'" >&2
    echo 'Use one of: low, medium, xhigh' >&2
    exit 2
    ;;
esac

# Same stable derivation as opencode-tellico, for the same reason: spread
# users across the two servers without moving a given device around.
if [ -z "$node" ]; then
  node=${TELLICO_CODEX_NODE:-}
fi
if [ -z "$node" ]; then
  seed=$(printf '%s' "${USER:-unknown}@$(uname -n)" | cksum | cut -d' ' -f1)
  node=$((seed % 2))
fi
case $node in
  0|1) ;;
  *)
    echo "codex-tellico: node must be 0 or 1, got '$node'" >&2
    exit 2
    ;;
esac

profile=${TELLICO_CODEX_PROFILE:-tellico}

# Codex must go through the gateway, not straight at a model server. It sends
# `instructions` and a developer message together, which llama.cpp turns into
# two system messages, and the Qwen chat template rejects any system message
# that is not first. The gateway folds them into one.
gateway_env="$config_home/tellico-gateway/gateway.env"
base_url=${TELLICO_CODEX_BASE_URL:-}
if [ -z "$base_url" ]; then
  if [ "${TELLICO_MODE:-tunnel}" = gateway ] && [ -n "${TELLICO_GATEWAY_URL:-}" ]; then
    base_url="${TELLICO_GATEWAY_URL%/}/node${node}"
  elif [ -r "$gateway_env" ]; then
    # This host runs the gateway itself; reach it over loopback.
    # shellcheck disable=SC1090
    . "$gateway_env"
    base_url="http://${TELLICO_GATEWAY_BIND:-127.0.0.1}:${TELLICO_GATEWAY_PORT:-4000}/v1/node${node}"
  fi
fi

# The gateway authenticates per user, so the cluster key is not a credential
# for it. A gateway-mode device already holds the right one.
if [ -n "${TELLICO_CODEX_KEY_FILE:-}" ]; then
  key_file=$TELLICO_CODEX_KEY_FILE
elif [ -s "$config_dir/gateway-key" ]; then
  key_file="$config_dir/gateway-key"
elif [ "${TELLICO_MODE:-tunnel}" = gateway ]; then
  key_file="$config_dir/api-key"
else
  key_file=
fi

if [ -z "$base_url" ] || [ -z "$key_file" ]; then
  echo 'codex-tellico: Codex needs a Tellico gateway and a gateway API key.' >&2
  echo >&2
  echo 'Unlike OpenCode it cannot talk to the model servers directly: it sends' >&2
  echo 'a system prompt and a developer message together, and the chat template' >&2
  echo 'rejects the second system message that produces. The gateway merges' >&2
  echo 'them.' >&2
  echo >&2
  echo 'Either install this device in gateway mode:' >&2
  echo '  ./install.sh --gateway' >&2
  echo >&2
  echo 'or point it at one, with a key the operator minted for you:' >&2
  echo '  export TELLICO_CODEX_BASE_URL=https://HOST/v1' >&2
  echo "  printf '%s' \"\$KEY\" > $config_dir/gateway-key" >&2
  echo "  chmod 600 $config_dir/gateway-key" >&2
  exit 1
fi

if ! command -v codex >/dev/null 2>&1; then
  echo 'codex-tellico: codex is not installed or not on PATH' >&2
  echo 'Install it from https://developers.openai.com/codex and rerun.' >&2
  exit 1
fi
if [ ! -r "$codex_home/$profile.config.toml" ]; then
  echo "codex-tellico: missing $codex_home/$profile.config.toml" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi
if [ ! -s "$key_file" ]; then
  echo "codex-tellico: no API key at $key_file" >&2
  exit 1
fi

# The models must be reachable before Codex starts. In tunnel mode this brings
# the forwards up; in gateway mode it only checks that the gateway answers.
if ! "$tunnel_command" start >/dev/null; then
  "$tunnel_command" status >&2 || true
  exit 1
fi

# Codex reads the key from the environment variable the profile names.
TELLICO_API_KEY=$(cat "$key_file")
export TELLICO_API_KEY

set -- -p "$profile" \
  -c "model_providers.${profile}.base_url=\"$base_url\"" "$@"
if [ -n "$think" ]; then
  set -- -c "model_reasoning_effort=\"$think\"" "$@"
fi
exec codex "$@"
