#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
env_file="$config_dir/client.env"

if [ -r "$env_file" ]; then
  # Generated by install.sh after validating each value.
  # shellcheck disable=SC1090
  . "$env_file"
fi

ssh_host=${TELLICO_SSH_HOST:-tellico}
port0=${TELLICO_QWEN_PORT0:-18080}
port1=${TELLICO_QWEN_PORT1:-18081}
key_file="$config_dir/api-key"
runtime_parent=${XDG_RUNTIME_DIR:-"$HOME/.cache"}
runtime_dir="$runtime_parent/tellico-qwen"
control_socket="$runtime_dir/control"
unit_name=tellico-qwen-tunnel.service

have_user_unit() {
  command -v systemctl >/dev/null 2>&1 &&
    systemctl --user cat "$unit_name" >/dev/null 2>&1
}

control_running() {
  ssh -S "$control_socket" -O check "$ssh_host" >/dev/null 2>&1
}

refresh_key() {
  mkdir -p "$config_dir"
  chmod 700 "$config_dir"
  umask 077
  key_tmp="$config_dir/.api-key.tmp.$$"
  trap 'rm -f "$key_tmp"' EXIT HUP INT TERM
  ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_host" \
    'cat /home/bbogale/qwen38-cluster/secrets/api-key' >"$key_tmp"
  test -s "$key_tmp"
  mv "$key_tmp" "$key_file"
  chmod 600 "$key_file"
  trap - EXIT HUP INT TERM
}

start_tunnel() {
  mkdir -p "$runtime_dir"
  chmod 700 "$runtime_dir"

  if have_user_unit; then
    systemctl --user start "$unit_name"
    return
  fi

  if control_running; then
    return
  fi

  rm -f "$control_socket"
  ssh -o BatchMode=yes -fN -M -S "$control_socket" \
    -o ExitOnForwardFailure=yes \
    -o ControlPersist=no \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -L "127.0.0.1:${port0}:tellico-compute0:8000" \
    -L "127.0.0.1:${port1}:tellico-compute1:8000" \
    "$ssh_host"
}

stop_tunnel() {
  if have_user_unit; then
    systemctl --user stop "$unit_name"
  fi
  if control_running; then
    ssh -S "$control_socket" -O exit "$ssh_host" >/dev/null
  fi
  rm -f "$control_socket"
}

health_one() {
  port=$1
  label=$2
  if [ ! -s "$key_file" ]; then
    printf '%-20s %s\n' "$label" 'no local API key'
    return 1
  fi
  if curl -fsS --max-time 5 \
    -H "Authorization: Bearer $(cat "$key_file")" \
    "http://127.0.0.1:${port}/health" >/dev/null; then
    printf '%-20s %s\n' "$label" ready
    return 0
  fi
  printf '%-20s %s\n' "$label" unavailable
  return 1
}

status_tunnel() {
  if have_user_unit; then
    if systemctl --user is-active --quiet "$unit_name"; then
      printf '%-20s %s\n' tunnel running
    else
      printf '%-20s %s\n' tunnel stopped
    fi
  elif control_running; then
    printf '%-20s %s\n' tunnel running
  else
    printf '%-20s %s\n' tunnel stopped
  fi

  status=0
  health_one "$port0" 'tellico-0 / node 0' || status=1
  health_one "$port1" 'tellico-1 / node 1' || status=1
  return "$status"
}

wait_healthy() {
  count=0
  while [ "$count" -lt 30 ]; do
    if health_one "$port0" 'tellico-0 / node 0' >/dev/null 2>&1 &&
      health_one "$port1" 'tellico-1 / node 1' >/dev/null 2>&1; then
      return 0
    fi
    count=$((count + 1))
    sleep 1
  done
  return 1
}

usage() {
  echo "usage: tellico-qwen-tunnel {start|stop|restart|status|refresh-key|cluster-status}" >&2
  exit 2
}

case ${1:-} in
  start)
    refresh_key
    start_tunnel
    if ! wait_healthy; then
      echo 'Tunnel is running, but one or both model servers are unavailable.' >&2
      echo "Check the allocation with: ssh $ssh_host qwen38-status" >&2
      exit 1
    fi
    status_tunnel
    ;;
  stop)
    stop_tunnel
    ;;
  restart)
    stop_tunnel
    refresh_key
    start_tunnel
    if ! wait_healthy; then
      echo 'Tunnel restarted, but one or both model servers are unavailable.' >&2
      echo "Check the allocation with: ssh $ssh_host qwen38-status" >&2
      exit 1
    fi
    status_tunnel
    ;;
  status)
    status_tunnel
    ;;
  refresh-key)
    refresh_key
    echo "Updated $key_file"
    ;;
  cluster-status)
    exec ssh -o BatchMode=yes "$ssh_host" qwen38-status
    ;;
  *)
    usage
    ;;
esac
