#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
env_file="$config_dir/client.env"

if [ -r "$env_file" ]; then
  # Generated by install.sh after validating each value.
  # shellcheck disable=SC1090
  . "$env_file"
fi

ssh_host=${TELLICO_SSH_HOST:-tellico}
port0=${TELLICO_QWEN_PORT0:-18080}
port1=${TELLICO_QWEN_PORT1:-18081}
key_file="$config_dir/api-key"
: "${TELLICO_REMOTE_KEY_PATH:=/data/gclab/qwen38/secrets/api-key}"
runtime_parent=${XDG_RUNTIME_DIR:-"$HOME/.cache"}
runtime_dir="$runtime_parent/tellico-qwen"
control_socket="$runtime_dir/control"
unit_name=tellico-qwen-tunnel.service
mode=${TELLICO_MODE:-tunnel}

load_checks() {
  checks="$config_dir/lib/checks.sh"
  if [ ! -r "$checks" ]; then
    echo "tellico-qwen-tunnel: missing $checks" >&2
    echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
    exit 1
  fi
  # Installed by install.sh alongside this script.
  # shellcheck disable=SC1090
  . "$checks"
}

have_user_unit() {
  command -v systemctl >/dev/null 2>&1 &&
    systemctl --user cat "$unit_name" >/dev/null 2>&1
}

control_running() {
  ssh -S "$control_socket" -O check "$ssh_host" >/dev/null 2>&1
}

refresh_key() {
  mkdir -p "$config_dir"
  chmod 700 "$config_dir"
  umask 077
  key_tmp="$config_dir/.api-key.tmp.$$"
  trap 'rm -f "$key_tmp"' EXIT HUP INT TERM
  ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_host" \
    "cat '$TELLICO_REMOTE_KEY_PATH'" >"$key_tmp"
  test -s "$key_tmp"
  mv "$key_tmp" "$key_file"
  chmod 600 "$key_file"
  trap - EXIT HUP INT TERM
}

start_tunnel() {
  mkdir -p "$runtime_dir"
  chmod 700 "$runtime_dir"

  if have_user_unit; then
    systemctl --user start "$unit_name"
    return
  fi

  if control_running; then
    return
  fi

  rm -f "$control_socket"
  ssh -o BatchMode=yes -fN -M -S "$control_socket" \
    -o ExitOnForwardFailure=yes \
    -o ControlPersist=no \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -L "127.0.0.1:${port0}:tellico-compute0:8000" \
    -L "127.0.0.1:${port1}:tellico-compute1:8000" \
    "$ssh_host"
}

stop_tunnel() {
  if have_user_unit; then
    systemctl --user stop "$unit_name"
  fi
  if control_running; then
    ssh -S "$control_socket" -O exit "$ssh_host" >/dev/null
  fi
  rm -f "$control_socket"
}

health_one() {
  port=$1
  label=$2
  if [ ! -s "$key_file" ]; then
    printf '%-20s %s\n' "$label" 'no local API key'
    return 1
  fi
  if curl -fsS --max-time 5 \
    -H "Authorization: Bearer $(cat "$key_file")" \
    "http://127.0.0.1:${port}/health" >/dev/null; then
    printf '%-20s %s\n' "$label" ready
    return 0
  fi
  printf '%-20s %s\n' "$label" unavailable
  return 1
}

status_tunnel() {
  if have_user_unit; then
    if systemctl --user is-active --quiet "$unit_name"; then
      printf '%-20s %s\n' tunnel running
    else
      printf '%-20s %s\n' tunnel stopped
    fi
  elif control_running; then
    printf '%-20s %s\n' tunnel running
  else
    printf '%-20s %s\n' tunnel stopped
  fi

  status=0
  health_one "$port0" 'tellico-0 / node 0' || status=1
  health_one "$port1" 'tellico-1 / node 1' || status=1
  return "$status"
}

wait_healthy() {
  count=0
  while [ "$count" -lt 30 ]; do
    if health_one "$port0" 'tellico-0 / node 0' >/dev/null 2>&1 &&
      health_one "$port1" 'tellico-1 / node 1' >/dev/null 2>&1; then
      return 0
    fi
    count=$((count + 1))
    sleep 1
  done
  return 1
}

doctor_tunnel() {
  load_checks

  echo "Tellico client doctor (ssh host: $ssh_host)"
  echo
  doctor_status=0
  if ! tellico_preflight; then
    doctor_status=1
  elif ! tellico_check_allocation; then
    doctor_status=1
  else
    echo
    status_tunnel || doctor_status=1
  fi
  return "$doctor_status"
}

gateway_status() {
  load_checks
  base=$(tellico_gateway_url)
  printf '%-20s %s\n' mode gateway
  printf '%-20s %s\n' endpoint "${base:-unset}"
  if tellico_gateway_probe "$key_file"; then
    printf '%-20s %s\n' models ready
    return 0
  fi
  printf '%-20s %s\n' models "$tellico_gateway_result"
  return 1
}

gateway_doctor() {
  load_checks
  echo 'Tellico client doctor (gateway mode)'
  echo
  tellico_check_gateway "$key_file"
}

usage() {
  if [ "$mode" = gateway ]; then
    echo 'usage: tellico-qwen-tunnel {start|stop|restart|status|doctor}' >&2
    echo >&2
    echo 'This device is in gateway mode: there is no SSH tunnel, so start' >&2
    echo 'and restart only check that the gateway answers.' >&2
    exit 2
  fi
  echo "usage: tellico-qwen-tunnel {start|stop|restart|status|doctor|refresh-key|cluster-status}" >&2
  exit 2
}

if [ "$mode" = gateway ]; then
  case ${1:-} in
    start|restart)
      # opencode-tellico calls this before a session; reachability is the
      # only precondition gateway mode has.
      gateway_status
      ;;
    stop)
      echo 'Gateway mode holds no tunnel, so there is nothing to stop.'
      ;;
    status)
      gateway_status
      ;;
    doctor|cluster-status)
      gateway_doctor
      ;;
    refresh-key)
      echo 'tellico-qwen-tunnel: gateway mode cannot refresh its own key.' >&2
      echo 'The key comes from whoever runs the gateway. With a new one:' >&2
      echo "  ./install.sh --gateway-url ${TELLICO_GATEWAY_URL:-https://HOST/v1}" >&2
      exit 1
      ;;
    *)
      usage
      ;;
  esac
  exit
fi

case ${1:-} in
  start)
    refresh_key
    start_tunnel
    if ! wait_healthy; then
      echo 'Tunnel is running, but one or both model servers are unavailable.' >&2
      echo "Check the allocation with: ssh $ssh_host qwen38-status" >&2
      exit 1
    fi
    status_tunnel
    ;;
  stop)
    stop_tunnel
    ;;
  restart)
    stop_tunnel
    refresh_key
    start_tunnel
    if ! wait_healthy; then
      echo 'Tunnel restarted, but one or both model servers are unavailable.' >&2
      echo "Check the allocation with: ssh $ssh_host qwen38-status" >&2
      exit 1
    fi
    status_tunnel
    ;;
  status)
    status_tunnel
    ;;
  doctor)
    doctor_tunnel
    ;;
  refresh-key)
    refresh_key
    echo "Updated $key_file"
    ;;
  cluster-status)
    # qwen38-status lives in the service owner's home directory and is not
    # readable by other accounts, so report the allocation through the shared
    # check instead: squeue plus an authenticated probe of each server.
    load_checks
    tellico_check_allocation
    ;;
  *)
    usage
    ;;
esac
