#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-qwen"
fragment="$config_dir/crush/tellico.crushrc"
crushrc="$config_home/crush/crushrc"
checks="$config_dir/lib/checks.sh"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tunnel_command="$script_dir/tellico-qwen-tunnel"

node=
think=${TELLICO_THINK:-}

usage() {
  cat <<'EOF'
usage: crush-tellico [0|1] [--think LEVEL] [CRUSH_ARGS...]

Starts Charm's Crush against Tellico's two Qwen servers. The optional 0 or 1
selects which server answers; with no number it is derived from this device,
so that several users do not all land on node 0 and compete for one server's
prompt cache. It is stable for a given device, and TELLICO_LEAD_NODE
overrides it.

Crush is a single-agent harness today -- its subagent support is an open pull
request -- so this is the Crush counterpart of "opencode-tellico --solo" and
of pi-tellico. What it adds over those two is a permission prompt in front of
every tool call, PreToolUse hooks, and LSP integration.

Everything after the options goes to Crush unchanged: "run" for one-shot
output, --continue, --session, --cwd, --yolo, and so on. See "crush --help".

Crush has no flag that selects a model, so the node and the thinking level
reach it through the configuration: this script exports TELLICO_LEAD_NODE and
TELLICO_THINK, and tellico.crushrc reads them. That is also why the fragment
has to be sourced from your own crushrc; install.sh adds the line.

  off      no reasoning at all, fastest
  low      brief reasoning
  medium   the default
  xhigh    the most the chat template allows

Inside a session, Crush's own model picker switches node: tellico-0 and
tellico-1 both carry the model, and the -quiet copies of each never think.

examples:
  crush-tellico
  crush-tellico 0
  crush-tellico 1 --think off
  crush-tellico 0 run 'Review this repository'
  crush-tellico 0 --continue

environment:
  TELLICO_THINK    Default thinking level, same values as --think, which
                   overrides it. Unset, the configured level (medium) applies.
  TELLICO_LEAD_NODE
                   Force the node to 0 or 1 instead of deriving it from this
                   device.
EOF
}

case ${1:-} in
  0|1)
    node=$1
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

# After the node, so "crush-tellico 1 --think low" reads naturally. Anything
# else is Crush's own argument and is passed through untouched.
while [ "$#" -gt 0 ]; do
  case $1 in
    --think)
      if [ "$#" -lt 2 ]; then
        echo 'crush-tellico: --think requires a level' >&2
        exit 2
      fi
      think=$2
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

# Crush's own --reasoning-effort takes low, medium or high; the Qwen3.8
# template takes low, medium or xhigh and raises on "high". These four are the
# intersection plus off, and match the other two launchers.
case $think in
  ''|off|low|medium|xhigh) ;;
  *)
    echo "crush-tellico: unknown thinking level '$think'" >&2
    echo 'Use one of: off, low, medium, xhigh' >&2
    exit 2
    ;;
esac

if ! command -v crush >/dev/null 2>&1; then
  echo 'crush-tellico: crush is not installed or not on PATH' >&2
  echo 'Install it from https://github.com/charmbracelet/crush and rerun.' >&2
  exit 1
fi

if [ ! -r "$fragment" ]; then
  echo "crush-tellico: missing $fragment" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi

# Without the source line Crush starts with no Tellico provider at all and
# silently falls back to whatever model the user already had, which looks like
# the setup working until the first reply comes from somewhere else.
if ! grep -qF "$fragment" "$crushrc" 2>/dev/null; then
  echo "crush-tellico: $crushrc does not source $fragment" >&2
  echo 'Add it with ./install.sh, or by hand:' >&2
  echo >&2
  echo "  echo 'source \"$fragment\"' >>\"$crushrc\"" >&2
  exit 1
fi

if [ ! -r "$checks" ]; then
  echo "crush-tellico: missing $checks" >&2
  echo 'Rerun install.sh from the tellico-agentic-setup repository.' >&2
  exit 1
fi
# Installed by install.sh alongside this script.
# shellcheck disable=SC1090
. "$checks"

# Shared with opencode-tellico and pi-tellico, so one device does not start on
# node 0 in one harness and node 1 in another.
if [ -z "$node" ]; then
  node=$(tellico_default_lead_node) || exit $?
fi

if ! "$tunnel_command" start >/dev/null; then
  "$tunnel_command" status >&2 || true
  exit 1
fi

# Read by tellico.crushrc, which Crush sources at startup. Crush has no
# equivalent of OPENCODE_CONFIG or PI_CODING_AGENT_DIR to point at a private
# configuration, so this is the whole mechanism.
export TELLICO_LEAD_NODE="$node"
if [ -n "$think" ]; then
  export TELLICO_THINK="$think"
fi

exec crush "$@"
