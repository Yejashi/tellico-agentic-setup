#!/bin/sh
# Control for the Tellico relay: the service behind the phone app at /tellico/.
#
# It owns the relay's systemd user unit and nothing else. The gateway and the
# tunnel have their own scripts; a restart here never touches either, so no
# one's session is interrupted -- connected plugins simply resend their
# sessions a few seconds after the relay comes back.
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-relay"
env_file="$config_dir/relay.env"
unit_name=tellico-relay.service

if [ -r "$env_file" ]; then
  # Generated by install-relay.sh after validating each value.
  # shellcheck disable=SC1090
  . "$env_file"
fi

bind=${TELLICO_RELAY_BIND:-127.0.0.1}
port=${TELLICO_RELAY_PORT:-4100}
script=${TELLICO_RELAY_SCRIPT:-"$HOME/.local/lib/tellico-relay/tellico_relay.py"}
base="http://$bind:$port/tellico"

have_user_unit() {
  command -v systemctl >/dev/null 2>&1 &&
    systemctl --user cat "$unit_name" >/dev/null 2>&1
}

health() {
  curl -fsS -m 5 "$base/healthz" 2>/dev/null || true
}

start_relay() {
  have_user_unit || {
    echo 'tellico-relay: no service unit; run it in the foreground: tellico-relay run' >&2
    exit 1
  }
  systemctl --user start "$unit_name"
  i=0
  while [ "$i" -lt 20 ]; do
    if [ -n "$(health)" ]; then
      echo "tellico-relay: up on $base/"
      return 0
    fi
    i=$((i + 1))
    sleep 0.5
  done
  echo 'tellico-relay: did not answer within 10s.' >&2
  echo '  journalctl --user -u tellico-relay -n 50' >&2
  return 1
}

stop_relay() {
  if have_user_unit; then
    systemctl --user stop "$unit_name" 2>/dev/null || true
  fi
  echo 'tellico-relay: stopped'
}

run_relay() {
  [ -r "$env_file" ] || { echo 'tellico-relay: run relay/install-relay.sh first.' >&2; exit 1; }
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
  exec python3 "$script"
}

status_relay() {
  if have_user_unit; then
    printf '%-20s %s\n' relay "$(systemctl --user is-active "$unit_name" 2>/dev/null || true)"
  fi
  body=$(health)
  if [ -z "$body" ]; then
    printf '%-20s %s\n' endpoint unreachable
    return 1
  fi
  printf '%-20s %s\n' endpoint "$base/"
  printf '%s' "$body" | python3 -c '
import json, sys
state = json.load(sys.stdin)
print("%-20s %s" % ("machines online", state.get("hostsOnline", 0)))
print("%-20s %s" % ("epoch", state.get("epoch", "?")))
' 2>/dev/null || true
  printf '%-20s %s\n' 'gateway keys' "${TELLICO_GATEWAY_KEYS:-unknown}"
  if [ -s "$config_dir/tokens" ]; then
    printf '%-20s %s\n' 'phones signed in' "$(wc -l <"$config_dir/tokens" | tr -d ' ')"
  fi
}

logs_relay() {
  have_user_unit || { echo 'tellico-relay: no service unit, so no journal.' >&2; exit 1; }
  exec journalctl --user -u "$unit_name" "$@"
}

usage() {
  cat >&2 <<'USAGE'
usage: tellico-relay <command>

  status                   service, endpoint, machines online, phones
  start | stop | restart   the systemd user service
  run                      foreground, for a host without systemd
  logs [journalctl args]   the relay's log: sign-ins, machines, commands --
                           never what a session says
USAGE
  exit 2
}

case ${1:-} in
  start) start_relay ;;
  stop) stop_relay ;;
  restart)
    stop_relay
    start_relay
    ;;
  status) status_relay ;;
  run) run_relay ;;
  logs)
    shift
    logs_relay "$@"
    ;;
  *) usage ;;
esac
