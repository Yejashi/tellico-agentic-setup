#!/bin/sh
# Control and key management for the Tellico Qwen API gateway.
#
# The gateway is a long-lived local service; this script owns its systemd
# user unit, its per-user API keys, and its public exposure. It never touches
# the SSH tunnel: tellico-qwen-tunnel still owns that.
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-gateway"
env_file="$config_dir/gateway.env"
unit_name=tellico-gateway.service

if [ -r "$env_file" ]; then
  # Generated by install-gateway.sh after validating each value.
  # shellcheck disable=SC1090
  . "$env_file"
fi

bind=${TELLICO_GATEWAY_BIND:-127.0.0.1}
port=${TELLICO_GATEWAY_PORT:-4000}
keys_file=${TELLICO_GATEWAY_KEYS:-"$config_dir/keys"}
upstream_key=${TELLICO_GATEWAY_UPSTREAM_KEY:-"$config_home/tellico-qwen/api-key"}
model=${TELLICO_GATEWAY_MODEL:-qwen3.8-27b-gsq-iq3s}
script=${TELLICO_GATEWAY_SCRIPT:-"$HOME/.local/lib/tellico-gateway/tellico_gateway.py"}
monitor=${TELLICO_GATEWAY_MONITOR:-"$(dirname "$script")/tellico_monitor.py"}
bin_dir="$HOME/.local/bin"

# Find tellico-qwen-tunnel whether or not ~/.local/bin is on this PATH, which
# it often is not for a service or a cron job.
tunnel_cmd() {
  if [ -x "$bin_dir/tellico-qwen-tunnel" ]; then
    printf '%s\n' "$bin_dir/tellico-qwen-tunnel"
  elif command -v tellico-qwen-tunnel >/dev/null 2>&1; then
    command -v tellico-qwen-tunnel
  fi
}

have_user_unit() {
  command -v systemctl >/dev/null 2>&1 &&
    systemctl --user cat "$unit_name" >/dev/null 2>&1
}

require_python() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo 'tellico-gateway: python3 is required.' >&2
    exit 1
  fi
}

# Writes a fresh key to stdout. Nothing else may ever print it.
mint_key() {
  python3 -c 'import secrets; print("sk-tellico-" + secrets.token_urlsafe(32))'
}

hash_key() {
  python3 -c 'import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())' "$1"
}

user_exists() {
  [ -f "$keys_file" ] && awk -v u="$1" '!/^#/ && $2 == u { found = 1 }
    END { exit !found }' "$keys_file"
}

add_user() {
  name=${1:-}
  max_parallel=${2:-1}
  if [ -z "$name" ]; then
    echo 'usage: tellico-gateway add-user NAME [MAX_PARALLEL]' >&2
    exit 2
  fi
  case $name in
    *[!A-Za-z0-9._-]*)
      echo 'tellico-gateway: NAME may use letters, digits, dot, underscore, dash.' >&2
      exit 2
      ;;
  esac
  case $max_parallel in
    ''|*[!0-9]*)
      echo 'tellico-gateway: MAX_PARALLEL must be a positive integer.' >&2
      exit 2
      ;;
  esac
  require_python
  if user_exists "$name"; then
    echo "tellico-gateway: $name already has a key. Revoke it first:" >&2
    echo "  tellico-gateway revoke $name" >&2
    exit 1
  fi

  mkdir -p "$config_dir"
  chmod 700 "$config_dir"
  umask 077
  if [ ! -f "$keys_file" ]; then
    {
      echo '# Tellico gateway API keys: <sha256> <user> <max-parallel>'
      echo '# Managed by tellico-gateway add-user / revoke. No plaintext keys here.'
    } >"$keys_file"
  fi
  chmod 600 "$keys_file"

  key=$(mint_key)
  printf '%s %s %s\n' "$(hash_key "$key")" "$name" "$max_parallel" >>"$keys_file"

  echo "Added $name (max $max_parallel concurrent request(s))."
  echo
  echo 'This key is shown once and is not recoverable. Send it to the user:'
  echo
  printf '  %s\n' "$key"
  echo "  model     $model"
  if [ -n "$(published_url)" ]; then
    echo "  base URL  $(public_url)"
    echo
    echo 'The gateway picks up new keys within a second; no restart needed.'
  else
    echo
    echo 'There is no base URL to send yet: the gateway is not published, so it'
    echo "is reachable only from this host. The key itself is already live."
    echo
    echo '  tellico-gateway expose      # publish it, then:'
    echo '  tellico-gateway url         # the base URL to send out'
  fi
}

# Changing a limit must not rotate a key: the user is not at fault for the
# operator resizing them, and a new key means redistributing a credential.
set_limit() {
  name=${1:-}
  max_parallel=${2:-}
  if [ -z "$name" ] || [ -z "$max_parallel" ]; then
    echo 'usage: tellico-gateway set-limit NAME MAX_PARALLEL' >&2
    exit 2
  fi
  case $max_parallel in
    ''|*[!0-9]*|0)
      echo 'tellico-gateway: MAX_PARALLEL must be a positive integer.' >&2
      exit 2
      ;;
  esac
  if ! user_exists "$name"; then
    echo "tellico-gateway: no key for $name" >&2
    exit 1
  fi
  umask 077
  tmp="$keys_file.tmp.$$"
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  awk -v u="$name" -v n="$max_parallel" '
    /^#/ { print; next }
    $2 == u { printf "%s %s %s\n", $1, $2, n; next }
    { print }
  ' "$keys_file" >"$tmp"
  mv "$tmp" "$keys_file"
  chmod 600 "$keys_file"
  trap - EXIT HUP INT TERM
  echo "$name may now hold $max_parallel concurrent request(s). Their key is unchanged."
}

revoke_user() {
  name=${1:-}
  if [ -z "$name" ]; then
    echo 'usage: tellico-gateway revoke NAME' >&2
    exit 2
  fi
  if ! user_exists "$name"; then
    echo "tellico-gateway: no key for $name" >&2
    exit 1
  fi
  umask 077
  tmp="$keys_file.tmp.$$"
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  awk -v u="$name" '/^#/ || $2 != u' "$keys_file" >"$tmp"
  mv "$tmp" "$keys_file"
  chmod 600 "$keys_file"
  trap - EXIT HUP INT TERM
  echo "Revoked $name. In-flight requests finish; the next one gets 401."
}

list_users() {
  if [ ! -s "$keys_file" ] || [ -z "$(awk '!/^#/ && NF >= 2' "$keys_file")" ]; then
    echo 'No keys yet. Create one with: tellico-gateway add-user NAME'
    return 0
  fi
  printf '%-20s %s\n' USER MAX-PARALLEL
  awk '!/^#/ && NF >= 2 { printf "%-20s %s\n", $2, ($3 == "" ? 1 : $3) }' "$keys_file"
}

# The public https URL Funnel is serving, or empty when nothing is published.
published_url() {
  if command -v tailscale >/dev/null 2>&1; then
    tailscale funnel status 2>/dev/null |
      awk '/^https:\/\// { print $1; exit }' || true
  fi
}

public_url() {
  funnel=$(published_url) || funnel=''
  if [ -n "$funnel" ]; then
    printf '%s/v1\n' "${funnel%/}"
  else
    printf 'http://%s:%s/v1\n' "$bind" "$port"
  fi
}

check_public() {
  url=$(published_url)
  if [ -z "$url" ]; then
    printf '  %-22s %s\n' 'public endpoint' 'not published'
    return 0
  fi
  host=${url#https://}
  host=${host%%/*}
  printf '  %-22s %s\n' 'public endpoint' "$host"

  # Probe only the address families this host can route, or a machine
  # without IPv6 reports every AAAA record as broken.
  addresses=$(python3 -c '
import socket, sys

families = [socket.AF_INET]
probe = socket.socket(socket.AF_INET6, socket.SOCK_DGRAM)
try:
    probe.connect(("2000::", 53))
    families.append(socket.AF_INET6)
except OSError:
    pass
finally:
    probe.close()

found = set()
for family in families:
    try:
        found |= {info[4][0] for info in socket.getaddrinfo(sys.argv[1], 443, family)}
    except socket.gaierror:
        pass
print("\n".join(sorted(found)))
' "$host" 2>/dev/null) || addresses=''
  if [ -z "$addresses" ]; then
    printf '  %-22s %s\n' '' 'does not resolve'
    return 1
  fi

  bad=0
  total=0
  for address in $addresses; do
    total=$((total + 1))
    # curl needs an IPv6 literal bracketed in --resolve.
    case $address in
      *:*) resolve_to="[$address]" ;;
      *) resolve_to=$address ;;
    esac
    if curl -s -m 15 --resolve "$host:443:$resolve_to" -o /dev/null \
      "https://$host/health" 2>/dev/null; then
      printf '  %-22s %s\n' '' "$address ok"
    else
      printf '  %-22s %s\n' '' "$address UNREACHABLE"
      bad=$((bad + 1))
    fi
  done

  if [ "$bad" -gt 0 ]; then
    echo
    echo "    $bad of $total addresses for $host do not answer. Clients pick"
    echo '    one at random, so roughly that share of all requests will fail'
    echo '    with a TLS error before reaching the gateway.'
    echo '    This is upstream of you: the gateway itself is fine. Either wait'
    echo '    for the ingress to recover, or serve the endpoint yourself with'
    echo '    gateway/caddy/Caddyfile.example.'
    return 1
  fi
  return 0
}

start_gateway() {
  if have_user_unit; then
    systemctl --user start "$unit_name"
    wait_healthy
    return
  fi
  echo 'tellico-gateway: no systemd user unit; run it in the foreground with:' >&2
  echo '  tellico-gateway run' >&2
  exit 1
}

stop_gateway() {
  if have_user_unit; then
    systemctl --user stop "$unit_name"
  fi
}

run_monitor() {
  require_python
  if [ ! -r "$monitor" ]; then
    echo "tellico-gateway: missing $monitor" >&2
    echo 'Rerun gateway/install-gateway.sh from the repository.' >&2
    exit 1
  fi
  exec python3 "$monitor" "$@"
}

run_gateway() {
  require_python
  if [ ! -r "$script" ]; then
    echo "tellico-gateway: missing $script" >&2
    echo 'Rerun gateway/install-gateway.sh from the repository.' >&2
    exit 1
  fi
  exec python3 "$script"
}

gateway_health() {
  curl -fsS --max-time 5 "http://${bind}:${port}/health" 2>/dev/null
}

wait_healthy() {
  count=0
  while [ "$count" -lt 20 ]; do
    if gateway_health >/dev/null 2>&1; then
      return 0
    fi
    count=$((count + 1))
    sleep 1
  done
  return 1
}

status_gateway() {
  if have_user_unit; then
    if systemctl --user is-active --quiet "$unit_name"; then
      printf '%-20s %s\n' gateway running
    else
      printf '%-20s %s\n' gateway stopped
      return 1
    fi
  fi

  body=$(gateway_health || true)
  if [ -z "$body" ]; then
    printf '%-20s %s\n' endpoint unreachable
    return 1
  fi
  printf '%-20s %s\n' endpoint "http://${bind}:${port}"
  printf '%s' "$body" | python3 -c '
import json, sys
state = json.load(sys.stdin)
print("%-20s %s" % ("upstream", state["status"]))
for name, value in sorted(state["nodes"].items()):
    print("%-20s %s" % ("  " + name, value))
print("%-20s %d of %d" % ("in flight", state["inflight"], state["max_inflight"]))
' 2>/dev/null || printf '%-20s %s\n' upstream "$body"

  if [ -n "$(published_url)" ]; then
    printf '%-20s %s\n' 'public URL' "$(public_url)"
  else
    printf '%-20s %s\n' 'local URL' "$(public_url)"
    printf '%-20s %s\n' '' '(not published; see: tellico-gateway expose)'
  fi
  printf '%-20s %s\n' users "$(awk '!/^#/ && NF >= 2' "$keys_file" 2>/dev/null | wc -l | tr -d ' ')"
}

doctor_gateway() {
  echo 'Tellico gateway doctor'
  echo
  rc=0

  if command -v python3 >/dev/null 2>&1; then
    printf '  %-22s %s\n' python3 "$(python3 --version 2>&1)"
  else
    printf '  %-22s %s\n' python3 MISSING
    rc=1
  fi

  if [ -s "$upstream_key" ]; then
    printf '  %-22s %s\n' 'cluster key' "$upstream_key"
  else
    printf '  %-22s %s\n' 'cluster key' "MISSING ($upstream_key)"
    echo '    Fix: tellico-qwen-tunnel refresh-key'
    rc=1
  fi

  # The tunnel is the gateway's only path to the cluster, but it belongs to
  # tellico-qwen-tunnel; report on it without touching it.
  tunnel=$(tunnel_cmd)
  if [ -n "$tunnel" ]; then
    if "$tunnel" status >/dev/null 2>&1; then
      printf '  %-22s %s\n' 'ssh tunnel' 'up (both nodes answer)'
    else
      printf '  %-22s %s\n' 'ssh tunnel' 'DOWN or a node is unavailable'
      echo '    Fix: tellico-qwen-tunnel doctor'
      rc=1
    fi
  else
    printf '  %-22s %s\n' 'ssh tunnel' 'tellico-qwen-tunnel not installed'
    echo '    Fix: run ./install.sh from the repository root first'
    rc=1
  fi

  if [ -s "$keys_file" ] && [ -n "$(awk '!/^#/ && NF >= 2' "$keys_file")" ]; then
    printf '  %-22s %s users\n' 'api keys' \
      "$(awk '!/^#/ && NF >= 2' "$keys_file" | wc -l | tr -d ' ')"
  else
    printf '  %-22s %s\n' 'api keys' 'none yet'
    echo '    Fix: tellico-gateway add-user NAME'
  fi

  echo
  status_gateway || rc=1

  echo
  if [ -n "$(published_url)" ]; then
    printf '  %-22s %s\n' funnel on
    check_public || rc=1
  else
    printf '  %-22s %s\n' funnel 'off (local only)'
    echo '    Share it publicly with: tellico-gateway expose'
  fi

  return "$rc"
}

expose_gateway() {
  if ! command -v tailscale >/dev/null 2>&1; then
    echo 'tellico-gateway: tailscale is not installed.' >&2
    echo 'Use the Caddy recipe in gateway/caddy/Caddyfile.example instead.' >&2
    exit 1
  fi
  if ! tailscale funnel --bg "$port"; then
    echo >&2
    echo 'Funnel did not start. The usual two causes, in order:' >&2
    echo >&2
    echo '  1. Funnel is not enabled for the tailnet yet. The command above' >&2
    echo '     prints a login.tailscale.com link; open it once to approve' >&2
    echo '     this node, then rerun.' >&2
    echo '  2. "Access denied: serve config denied" means tailscaled wants' >&2
    echo '     root. Grant yourself the operator role once, instead of' >&2
    echo '     reaching for sudo every time:' >&2
    echo '       sudo tailscale set --operator=$USER' >&2
    echo >&2
    echo 'See https://tailscale.com/kb/1223/funnel' >&2
    exit 1
  fi
  echo
  echo "Public base URL: $(public_url)"
  echo 'Anyone on the internet can reach it, so only a valid API key keeps'
  echo 'them out. Keep an eye on: journalctl --user -u tellico-gateway -f'
  echo
  # A funnel can be "on" while an ingress address is black-holing TLS.
  check_public || true
}

unexpose_gateway() {
  tailscale funnel reset
  echo "Funnel off. The gateway is local again: http://${bind}:${port}"
}

usage() {
  cat >&2 <<'USAGE'
usage: tellico-gateway <command>

  start | stop | restart | status     the local gateway service
  run                                 run in the foreground (no systemd)
  doctor                              check every dependency in order
  add-user NAME [MAX_PARALLEL]        mint a key and print it once
  set-limit NAME N                    change concurrency, keeping the key
  revoke NAME                         delete a key
  list-users                          who has a key
  url                                 base URL to hand out
  check-public                        test every address the URL resolves to
  expose | unexpose                   publish via Tailscale Funnel
  monitor [--once] [--window 1h]      live view of users and load
  logs                                follow the request log
USAGE
  exit 2
}

case ${1:-} in
  start) start_gateway ;;
  stop) stop_gateway ;;
  restart)
    stop_gateway
    start_gateway
    ;;
  status) status_gateway ;;
  run) run_gateway ;;
  monitor)
    shift
    run_monitor "$@"
    ;;
  doctor) doctor_gateway ;;
  add-user)
    shift
    add_user "${1:-}" "${2:-1}"
    ;;
  set-limit)
    shift
    set_limit "${1:-}" "${2:-}"
    ;;
  revoke)
    shift
    revoke_user "${1:-}"
    ;;
  list-users) list_users ;;
  url) public_url ;;
  check-public) check_public ;;
  expose) expose_gateway ;;
  unexpose) unexpose_gateway ;;
  logs)
    if have_user_unit; then
      exec journalctl --user -u "$unit_name" -f -n 50
    fi
    echo 'tellico-gateway: no systemd unit; the foreground process logs to stdout.' >&2
    exit 1
    ;;
  *) usage ;;
esac
