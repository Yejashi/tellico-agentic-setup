# >>> tellico (dashboard/grafana/install-grafana.sh)
# Loopback only; Caddy publishes it under /grafana/. Grafana has its own
# login: admin, with a password set on first sign-in. No sign-ups, no
# anonymous access, nothing sent home.
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=3000
GF_SERVER_ROOT_URL=https://tellico-llm-tunnel.asc200035.projects.jetstream-cloud.org/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
# Grafana 13 downloads a dozen bundled plugins at start; none is used here.
GF_PLUGINS_PREINSTALL_DISABLED=true
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/tellico/tellico.json
# <<< tellico
