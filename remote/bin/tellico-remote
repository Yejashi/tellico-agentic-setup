#!/bin/sh
# Control for the phone-facing Tellico OpenCode server.
#
# The server is a long-lived local service; this script owns its systemd user
# unit, its password, its pairing links and the snippet the reverse proxy needs.
# It never touches the SSH tunnel or the gateway: those have their own scripts,
# and sessions in flight must survive anything done here.
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/tellico-remote"
env_file="$config_dir/remote.env"
password_file="$config_dir/password"
bcrypt_file="$config_dir/password.bcrypt"
unit_name=tellico-remote.service

if [ -r "$env_file" ]; then
  # Generated by install-remote.sh after validating each value.
  # shellcheck disable=SC1090
  . "$env_file"
fi

bind=${TELLICO_REMOTE_BIND:-127.0.0.1}
port=${TELLICO_REMOTE_PORT:-4096}
workspace=${TELLICO_REMOTE_WORKSPACE:-"$HOME/tellico-remote-work"}
connection=${TELLICO_REMOTE_CONNECTION:-${TELLICO_CONNECTION:-tunnel}}
public_url=${TELLICO_REMOTE_PUBLIC_URL:-}
bin_dir="$HOME/.local/bin"
base="http://${bind}:${port}"

fail() {
  echo "tellico-remote: $1" >&2
  shift
  for line in "$@"; do
    echo "  $line" >&2
  done
  exit 1
}

require_password() {
  [ -s "$password_file" ] ||
    fail 'no server password here.' \
      'Install the server first, from the repository root:' \
      '  remote/install-remote.sh'
}

require_python() {
  command -v python3 >/dev/null 2>&1 || fail 'python3 is required.'
}

have_user_unit() {
  command -v systemctl >/dev/null 2>&1 &&
    systemctl --user cat "$unit_name" >/dev/null 2>&1
}

# A call to the server's own API. curl reads -u from argv, which a process
# listing would show, so the password goes in through a 0600 netrc file this
# function owns and removes instead.
api_netrc() {
  api_path=$1
  shift
  require_python
  require_password
  netrc=$(mktemp "${TMPDIR:-/tmp}/tellico-remote.XXXXXX")
  chmod 600 "$netrc"
  # shellcheck disable=SC2064
  trap "rm -f '$netrc'" EXIT INT TERM
  printf 'machine %s port %s login opencode password %s\n' \
    "$bind" "$port" "$(cat "$password_file")" >"$netrc"
  curl -fsS -m "${TELLICO_REMOTE_TIMEOUT:-10}" --netrc-file "$netrc" \
    "$base$api_path" "$@"
  rm -f "$netrc"
  trap - EXIT INT TERM
}

server_info() {
  api_netrc /api/info 2>/dev/null || true
}

start_server() {
  if have_user_unit; then
    systemctl --user start "$unit_name"
  else
    fail 'there is no service unit for this server.' \
      'Run it in the foreground instead:' \
      '  tellico-remote run'
  fi
  # Wait for it to answer rather than reporting a pid as success.
  i=0
  while [ "$i" -lt 30 ]; do
    if [ -n "$(server_info)" ]; then
      echo "tellico-remote: up on $base"
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  echo 'tellico-remote: the server did not answer within 30s.' >&2
  echo '  journalctl --user -u tellico-remote -n 50' >&2
  return 1
}

stop_server() {
  if have_user_unit; then
    systemctl --user stop "$unit_name" 2>/dev/null || true
  fi
  echo 'tellico-remote: stopped'
}

# The foreground path, for a host with no systemd user manager.
run_server() {
  [ -r "$env_file" ] || fail 'no settings file; run remote/install-remote.sh first.'
  [ -x "$bin_dir/opencode-tellico" ] ||
    fail 'opencode-tellico is not installed; run ./install.sh first.'
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
  cd "$workspace"
  exec "$bin_dir/opencode-tellico" serve --hostname "$bind" --port "$port"
}

status_server() {
  if have_user_unit; then
    state=$(systemctl --user is-active "$unit_name" 2>/dev/null || true)
    printf '%-20s %s\n' server "${state:-unknown}"
  fi

  info=$(server_info)
  if [ -z "$info" ]; then
    printf '%-20s %s\n' endpoint unreachable
    return 1
  fi
  printf '%-20s %s\n' endpoint "$base"
  printf '%s' "$info" | python3 -c '
import json, sys
info = json.load(sys.stdin)
print("%-20s %s" % ("opencode", info.get("version", "?")))
' 2>/dev/null || true
  printf '%-20s %s\n' connection "$connection"
  printf '%-20s %s\n' workspace "$workspace"

  sessions=$(api_netrc "/api/session?directory=$workspace" 2>/dev/null |
    python3 -c 'import json,sys; print(len(json.load(sys.stdin)["data"]))' 2>/dev/null) || sessions=''
  [ -n "$sessions" ] && printf '%-20s %s\n' sessions "$sessions"

  active=$(api_netrc "/api/session/active?directory=$workspace" 2>/dev/null |
    python3 -c 'import json,sys; print(len(json.load(sys.stdin)["data"]))' 2>/dev/null) || active=''
  [ -n "$active" ] && printf '%-20s %s\n' 'generating now' "$active"

  if [ -n "$public_url" ]; then
    printf '%-20s %s\n' 'public URL' "$public_url"
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "$public_url/api/info" 2>/dev/null) || code=''
    case $code in
      401) printf '%-20s %s\n' 'published' 'yes, and locked (401 without the password)' ;;
      200) printf '%-20s %s\n' 'published' 'OPEN -- it answers with no password; see: tellico-remote caddy' ;;
      '') printf '%-20s %s\n' 'published' 'no answer from the public URL' ;;
      *) printf '%-20s %s\n' 'published' "answers $code" ;;
    esac
  else
    printf '%-20s %s\n' 'public URL' 'none set (--public-url); loopback only'
  fi
}

show_password() {
  require_password
  cat "$password_file"
}

# A single-use link that hands the phone a session cookie, so the password is
# typed once at the proxy and never inside the app.
pair_server() {
  url=${1:-$public_url}
  [ -n "$url" ] ||
    fail 'no URL to build a link from.' \
      'Pass one, or record it so status can check it too:' \
      '  tellico-remote pair https://host.example' \
      '  remote/install-remote.sh --public-url https://host.example'
  require_python
  code=$(api_netrc /api/pair -X POST |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["code"])' 2>/dev/null) || code=''
  [ -n "$code" ] ||
    fail 'the server would not issue a pairing code.' \
      'Check that it is up:' \
      '  tellico-remote status'
  echo 'Open this on the phone within 5 minutes. It works once:'
  echo
  printf '  %s/auth/connect/%s\n' "${url%/}" "$code"
  echo
  echo 'The proxy asks for the password first (user: opencode):'
  echo '  tellico-remote password'
  echo
  echo 'Then use the browser share menu to add it to the home screen.'
}

# The reverse-proxy snippet, with this host's hash already in it. Printed rather
# than installed: /etc/caddy belongs to root and may front other sites.
caddy_snippet() {
  [ -s "$bcrypt_file" ] || {
    command -v caddy >/dev/null 2>&1 ||
      fail 'no password hash, and no caddy here to make one.' \
        'On the proxy host:' \
        '  caddy hash-password --algorithm bcrypt' \
        'then paste the hash into the basicauth block below.'
    require_password
    umask 077
    caddy hash-password --algorithm bcrypt --plaintext "$(cat "$password_file")" >"$bcrypt_file"
    chmod 600 "$bcrypt_file"
  }
  host=${public_url#*://}
  host=${host%%/*}
  [ -n "$host" ] && host=${host%:*} || host=your.host.example
  cat <<EOF
# Add to the site block for $host, before any catch-all it already has.
# The hash below is this host's current password; after
# "install-remote.sh --rotate-password", paste a fresh snippet.

	# The OpenCode web app and its v2 API. Anything that gets past here can
	# run commands on this host, so the edge asks for the password as well
	# rather than leaving OpenCode's own check as the only lock. The
	# credentials are the server's own, so one Authorization header satisfies
	# both this check and OpenCode behind it.
	handle {
		basicauth {
			opencode $(cat "$bcrypt_file")
		}
		reverse_proxy $bind:$port {
			# Server-sent events carry the token stream; never buffer them.
			flush_interval -1
			transport http {
				read_timeout 3700s
				write_timeout 3700s
				response_header_timeout 120s
			}
			header_up X-Forwarded-For {remote_host}
		}
	}

# Any path the API clients already use must keep going to the gateway, so put
# its own handle block above this one:
#
#	@gateway path /v1 /v1/* /health
#	handle @gateway {
#		reverse_proxy 127.0.0.1:4000 { ... }
#	}
#
# remote/caddy/Caddyfile.example is the whole file with both in place.
EOF
}

logs_server() {
  have_user_unit ||
    fail 'there is no service unit, so there is no journal to follow.'
  systemctl --user status --no-pager "$unit_name" 2>&1 | head -n 5 || true
  echo
  exec journalctl --user -u "$unit_name" "$@"
}

doctor_server() {
  echo 'Tellico remote doctor'
  echo
  rc=0

  if [ -x "$bin_dir/opencode-tellico" ]; then
    if grep -q '= serve' "$bin_dir/opencode-tellico" 2>/dev/null; then
      printf '  %-22s %s\n' launcher "$bin_dir/opencode-tellico"
    else
      printf '  %-22s %s\n' launcher 'TOO OLD (no serve mode)'
      echo '    Fix: ./install.sh --no-start'
      rc=1
    fi
  else
    printf '  %-22s %s\n' launcher 'MISSING'
    echo '    Fix: run ./install.sh from the repository root'
    rc=1
  fi

  major=$(opencode --version 2>/dev/null | sed -n 's/^[^0-9]*\([0-9][0-9]*\)\..*/\1/p' | head -n 1)
  case $major in
    '') printf '  %-22s %s\n' opencode 'NOT ON PATH'; rc=1 ;;
    1)
      printf '  %-22s %s\n' opencode "1.x -- no web app, no v2 API, no pairing"
      echo '    Fix: opencode upgrade --major'
      rc=1
      ;;
    *) printf '  %-22s %s\n' opencode "$(opencode --version 2>&1)" ;;
  esac

  if [ -s "$password_file" ]; then
    perms=$(ls -l "$password_file" | cut -c1-10)
    printf '  %-22s %s\n' password "$perms"
    case $perms in
      -rw-------) ;;
      *) echo '    Fix: chmod 600 '"$password_file"; rc=1 ;;
    esac
  else
    printf '  %-22s %s\n' password 'MISSING'
    echo '    Fix: remote/install-remote.sh'
    rc=1
  fi

  if [ -n "$(server_info)" ]; then
    printf '  %-22s %s\n' server "answers on $base"
  else
    printf '  %-22s %s\n' server "NO ANSWER on $base"
    echo '    Fix: tellico-remote restart'
    rc=1
  fi

  code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$base/api/info" 2>/dev/null) || code=''
  case $code in
    401) printf '  %-22s %s\n' 'local auth' 'enforced' ;;
    '') printf '  %-22s %s\n' 'local auth' 'cannot tell (no answer)' ;;
    *)
      printf '  %-22s %s\n' 'local auth' "NOT ENFORCED (answers $code with no password)"
      rc=1
      ;;
  esac

  if [ "$connection" = gateway ]; then
    url=${TELLICO_CONNECTION_GATEWAY_URL:-}
    probe=${url%/v1}/health
    if [ -n "$url" ] && curl -fsS -m 5 "$probe" >/dev/null 2>&1; then
      printf '  %-22s %s\n' 'model connection' "gateway at $url"
    else
      printf '  %-22s %s\n' 'model connection' "gateway at ${url:-unset} UNREACHABLE"
      echo '    Fix: tellico-gateway status'
      rc=1
    fi
  else
    printf '  %-22s %s\n' 'model connection' 'tunnel'
    if [ -x "$bin_dir/tellico-qwen-tunnel" ]; then
      "$bin_dir/tellico-qwen-tunnel" status >/dev/null 2>&1 ||
        { echo '    Fix: tellico-qwen-tunnel doctor'; rc=1; }
    fi
  fi

  if [ -n "$public_url" ]; then
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "$public_url/api/info" 2>/dev/null) || code=''
    case $code in
      401) printf '  %-22s %s\n' 'public endpoint' "locked ($public_url)" ;;
      200)
        printf '  %-22s %s\n' 'public endpoint' 'OPEN WITHOUT A PASSWORD'
        echo '    Fix: put the basicauth block in place: tellico-remote caddy'
        rc=1
        ;;
      '') printf '  %-22s %s\n' 'public endpoint' "no answer ($public_url)" ;;
      *) printf '  %-22s %s\n' 'public endpoint' "answers $code" ;;
    esac
  else
    printf '  %-22s %s\n' 'public endpoint' 'not published'
  fi

  if command -v loginctl >/dev/null 2>&1; then
    if loginctl show-user "$(id -un)" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
      printf '  %-22s %s\n' linger 'enabled'
    else
      printf '  %-22s %s\n' linger 'off -- the server stops when you log out'
      echo "    Fix: sudo loginctl enable-linger $(id -un)"
    fi
  fi

  echo
  if [ "$rc" -eq 0 ]; then
    echo 'All good.'
  else
    echo 'Something above needs fixing.'
  fi
  return "$rc"
}

usage() {
  cat >&2 <<'USAGE'
usage: tellico-remote <command>

  status                              service, endpoint, sessions, exposure
  start | stop | restart              the systemd user service
  run                                 foreground, for a host without systemd
  doctor                              check the whole path, loopback to public
  logs [journalctl args]              follow the server log
  password                            print the server password
  pair [URL]                          one-time link that pairs a phone
  caddy                               the reverse-proxy snippet for this host
  url                                 print the published URL
USAGE
  exit 2
}

case ${1:-} in
  start) start_server ;;
  stop) stop_server ;;
  restart)
    stop_server
    start_server
    ;;
  status) status_server ;;
  run) run_server ;;
  doctor) doctor_server ;;
  logs)
    shift
    logs_server "$@"
    ;;
  password) show_password ;;
  pair)
    shift
    pair_server "${1:-}"
    ;;
  caddy) caddy_snippet ;;
  url)
    [ -n "$public_url" ] || fail 'no public URL recorded.'
    printf '%s\n' "$public_url"
    ;;
  *) usage ;;
esac
