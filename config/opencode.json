{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tellico-0": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tellico Qwen - node 0",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "{file:~/.config/tellico-qwen/api-key}",
        "headerTimeout": 3600000,
        "chunkTimeout": 3600000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B 128k - Tellico 0",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            },
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        }
      }
    },
    "tellico-1": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tellico Qwen - node 1",
      "options": {
        "baseURL": "http://127.0.0.1:18081/v1",
        "apiKey": "{file:~/.config/tellico-qwen/api-key}",
        "headerTimeout": 3600000,
        "chunkTimeout": 3600000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B 128k - Tellico 1",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": {
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true
              }
            },
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        }
      }
    }
  },
  "subagent_depth": 1,
  "agent": {
    "orchestrate-tellico-0": {
      "description": "Dual-node Tellico lead on node 0. Decomposes work and dispatches independent tasks to both node-pinned workers in parallel.",
      "mode": "primary",
      "model": "tellico-0/qwen3.8-27b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/orchestrate.md}",
      "steps": 100,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "webfetch": "allow",
        "lsp": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": {
          "*": "deny",
          "tellico-worker-0": "allow",
          "tellico-worker-1": "allow"
        },
        "doom_loop": "deny"
      }
    },
    "orchestrate-tellico-1": {
      "description": "Dual-node Tellico lead on node 1. Decomposes work and dispatches independent tasks to both node-pinned workers in parallel.",
      "mode": "primary",
      "model": "tellico-1/qwen3.8-27b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/orchestrate.md}",
      "steps": 100,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "webfetch": "allow",
        "lsp": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": {
          "*": "deny",
          "tellico-worker-0": "allow",
          "tellico-worker-1": "allow"
        },
        "doom_loop": "deny"
      }
    },
    "tellico-worker-0": {
      "description": "General implementation, investigation, testing, or review worker pinned to Qwen on tellico-compute0. Use for one bounded unit with explicit file ownership.",
      "mode": "subagent",
      "model": "tellico-0/qwen3.8-27b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/worker.md}",
      "steps": 200,
      "permission": {
        "*": "allow",
        "task": "deny",
        "doom_loop": "deny"
      }
    },
    "tellico-worker-1": {
      "description": "General implementation, investigation, testing, or review worker pinned to Qwen on tellico-compute1. Use for one bounded unit with explicit file ownership.",
      "mode": "subagent",
      "model": "tellico-1/qwen3.8-27b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/worker.md}",
      "steps": 200,
      "permission": {
        "*": "allow",
        "task": "deny",
        "doom_loop": "deny"
      }
    }
  }
}
