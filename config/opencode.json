          "tellico-worker-0": "allow",
          "tellico-worker-1": "allow"
        },
        "doom_loop": "deny"
      }
    },
    "tellico-worker-0": {
      "description": "General implementation, investigation, testing, or review worker on a Tellico server. Use for one bounded unit with explicit file ownership. Interchangeable with tellico-worker-1.",
      "mode": "subagent",
      "model": "tellico-0/qwen3.8-27b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/worker.md}",
      "steps": 200,
      "permission": {
        "*": "allow",
        "task": "deny",
        "doom_loop": "deny"
      }
    },
    "tellico-worker-1": {
      "description": "General implementation, investigation, testing, or review worker on a Tellico server. Use for one bounded unit with explicit file ownership. Interchangeable with tellico-worker-0.",
      "mode": "subagent",
