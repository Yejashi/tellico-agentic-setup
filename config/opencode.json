{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tellico-0": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tellico Qwen - node 0",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "{file:~/.config/tellico-qwen/api-key}",
        "headerTimeout": 3600000,
        "chunkTimeout": 3600000
