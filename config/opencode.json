      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B 96k - Tellico 0",
          "temperature": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 98304,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "parallel_tool_calls": true,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
