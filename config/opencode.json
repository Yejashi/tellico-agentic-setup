  "tool_output": {
    "max_lines": 300,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
    "tail_turns": 4,
    "preserve_recent_tokens": 8000
  },
  "subagent_depth": 1,
  "agent": {
    "orchestrate-tellico-0": {
      "description": "Dual-node Tellico lead on node 0. Decomposes work and dispatches independent tasks to both workers in parallel.",
      "mode": "primary",
      "model": "tellico-0/qwen3.8-27b",
      "temperature": 0.6,
      "top_p": 0.95,
      "prompt": "{file:./prompts/orchestrate.md}",
      "steps": 100,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "webfetch": "allow",
        "lsp": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": {
          "*": "deny",
          "tellico-worker-0": "allow",
          "tellico-worker-1": "allow"
        },
        "doom_loop": "deny"
      }
    },
    "orchestrate-tellico-1": {
      "description": "Dual-node Tellico lead on node 1. Decomposes work and dispatches independent tasks to both workers in parallel.",
